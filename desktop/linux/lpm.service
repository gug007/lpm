[Unit]
Description=lpm host
Requires=lpm-wm.service
After=lpm-wm.service
# A restarted display is a dead window for a process that already drew into the
# old one, so the app follows the display down and back up rather than surviving
# as something that can no longer render.
PartOf=lpm-xvfb.service

[Service]
Environment=DISPLAY=:99
Environment=HOME=%h
WorkingDirectory=%h
# Written by install.sh: SHELL, plus anything else this machine needs. systemd
# starts a service with almost no environment — no login shell has run — and
# terminals are spawned from $SHELL, so without it every "new terminal" on the
# host fails. The leading dash makes a missing file non-fatal.
EnvironmentFile=-/etc/lpm/host.env
ExecStart=/opt/lpm/lpm-desktop

# Kill the app, and only the app. Services on this host are panes of lpm's
# session daemon, and that daemon stays in this unit's cgroup — it forks away to
# PID 1, but cgroup membership is inherited across fork and unaffected by setsid,
# so the default KillMode=control-group would take it down with the app, which is
# the one thing it exists to survive. Scheduled job agents are in the same
# position: they `setsid` precisely so they outlive the app, and that doesn't
# leave the cgroup either. `process` signals the main process alone, so `systemctl restart lpm`
# (which the installer does on every update) stops being an event that ends the
# work on this box.
KillMode=process

# The other half of KillMode=process: it exempts *everything*, including the
# app's own `ssh -N` forwards, which nothing else reaps. See the script — the
# sweep lives there rather than inline because systemd expands `$…` in Exec
# lines, so a shell one-liner here would have its every variable eaten before
# /bin/sh ever saw it. The leading `-` keeps a failed sweep from failing the stop.
ExecStopPost=-/opt/lpm/host-cleanup.sh

# on-failure, NOT always — and this is a deliberate limit, not an oversight.
# KillMode above saves the services and the jobs, but not the agent terminals:
# those are PTYs owned by the app process itself, so every restart of this unit
# still ends whatever agents are running, silently and with no way to get the
# conversation back. `always` would turn an ordinary crash-and-recover into a
# whole session lost, so restarts are for a process that actually died, and a
# planned `systemctl restart lpm` is a decision to stop the agents on this box.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
