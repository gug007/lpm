{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the main, detached and quick terminal windows.",
  "windows": ["main", "detached-*", "quick-terminal"],
  "permissions": [
    "core:default",
    "core:app:allow-set-app-theme",
    "core:webview:allow-create-webview-window",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "opener:default",
    "dialog:default"
  ]
}
